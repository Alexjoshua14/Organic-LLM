# Organic LLM — local environment template
# Copy to `.env.local` (gitignored). Placeholders only — never commit real secrets.
# See README "Running locally", CONTRIBUTING.md, and SECURITY.md.
#
# Legend:
#   [REQUIRED — signed-in]  Needed for /chat, /rabbitholes, /sandbox, and protected /api/*
#   [OPTIONAL]              Feature works without it, or degrades gracefully
#   [DEMO ONLY]             No .env.local needed — see /showcase, /blog, /good-news?preview=1
#   [DEPLOY / CRON]         Production / scheduled jobs (not local dev)
#   [E2E / TEST]            Playwright or CI test harness only
#   [SCRIPT ONLY]           Used by maintenance scripts, not the Next.js app
#
# Demo routes need no .env.local — `bun dev` only.


# =============================================================================
# Clerk — authentication [REQUIRED — signed-in]
# Create an application at https://dashboard.clerk.com
# =============================================================================

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...


# =============================================================================
# Supabase — profiles, chats, rabbit holes [REQUIRED — signed-in]
# Schema snippets: docs/migrations/
# Regenerate types: bun run supabase:types (after `supabase link`)
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Legacy alias used by lib/supabase/organicStateStore.ts [OPTIONAL]
# Prefer NEXT_PUBLIC_SUPABASE_URL; set only if that module is exercised.
# SUPABASE_URL=https://your-project.supabase.co


# =============================================================================
# Chat encryption at rest [REQUIRED — signed-in]
# ORGANIC_LLM_ROOT_SECRET encrypts message bodies in Supabase.
# Generate a long random string (32+ bytes); do not rotate casually in dev.
# Key rotation: docs/e2ee.md
# =============================================================================

ORGANIC_LLM_ROOT_SECRET=
# ORGANIC_LLM_ACTIVE_KEY_ID=k1
# ORGANIC_LLM_KEY_REGISTRY_JSON={"k0":"previous-root-secret-for-migration"}


# =============================================================================
# Introspection integration [OPTIONAL — Introspection deep links]
# Shared secret (base64, 32+ decoded bytes) used by Introspection and Organic LLM
# to encrypt bootstrap payloads on "Open in Organic LLM" redirects.
# =============================================================================

# INTROSPECTION_ORGANIC_SHARED_SECRET=


# =============================================================================
# AI / Vercel AI Gateway [REQUIRED — signed-in chat LLM]
# Main chat (/api/chat, /api/ai/aion, profile knowledge, Good News pipeline) routes
# models through the gateway (e.g. openai/gpt-5.4-mini, anthropic/claude-sonnet-4.6).
# Get a key: https://vercel.com/docs/ai-gateway
# On Vercel deploy, VERCEL_OIDC_TOKEN is injected automatically as an alternative.
# =============================================================================

AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=   # auto on Vercel; optional local override

# Connected Ergon — per-user MCP OAuth [OPTIONAL]
# Product path: Settings → Connectors → Connect with Ergon (WorkOS Connect / AuthKit PKCE).
# Register Organic as a public PKCE Connect Application; redirect must match exactly:
#   {NEXT_PUBLIC_APP_URL}/api/profile/connectors/ergon/oauth/callback
# (or set ERGON_OAUTH_REDIRECT_URI). Requires ORGANIC_LLM_ROOT_SECRET to encrypt stored tokens.
ERGON_OAUTH_CLIENT_ID=
# ERGON_OAUTH_CLIENT_SECRET=   # only if AuthKit issued a confidential client
# ERGON_OAUTH_REDIRECT_URI=    # optional override; else derived from NEXT_PUBLIC_APP_URL
# ERGON_OAUTH_ISSUER=https://sufficient-forest-14.authkit.app
# ERGON_MCP_URL=https://ergon.coalescencelabs.app/mcp
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Connected Ergon — server-wide admin REST fallback [OPTIONAL]
# Prefer per-user MCP OAuth above. These remain an admin fallback for one profile when no
# per-user OAuth row is present (or lacks scope). Not the Settings product UX.
ERGON_URL=
ERGON_TOKEN=
ERGON_OWNER_PROFILE_ID=

# Connected apps for hard-set subagents [OPTIONAL — server only; unset disables each]
# Reed: Chronos local git MCP (Chronos runs it only with CHRONOS_MCP_TOKEN + CHRONOS_MCP_REPOS).
# Use http://localhost:3005/api/mcp locally; a deployed Organic needs an HTTPS tunnel to it.
CHRONOS_MCP_URL=
CHRONOS_MCP_TOKEN=
CHRONOS_OWNER_PROFILE_ID=
# Mira (sole Ergon subagent): docs, briefs, hooks and agent runs over MCP OAuth when the user
# connects in Settings. ERGON_AGENT_TOKEN + ERGON_OWNER_PROFILE_ID remain an admin REST fallback.
ERGON_AGENT_TOKEN=


# =============================================================================
# Arcadia GitHub read [OPTIONAL]
# Read-only tools on the Arcadia experience. The allowlist is required.
# Use a fine-grained PAT limited to those repositories
# (contents: read, pull requests: read, metadata: read).
# * is rejected unless GITHUB_READ_ALLOW_ANY=1 is also set.
# =============================================================================

# GITHUB_READ_TOKEN=
# GITHUB_READ_ALLOWLIST=owner/repo,owner/other
# GITHUB_READ_ALLOW_ANY=1


# =============================================================================
# OpenAI (direct provider) [OPTIONAL]
# Not used for main gateway chat. Needed for Mem0 fact-extraction (config/mem0-config.ts)
# and scripts/migrate-memories-v2.ts. Some legacy routes (spark, prometheus, remy) call
# openai() directly and need OPENAI_API_KEY if you use those endpoints.
# =============================================================================

# OPENAI_API_KEY=sk-...


# =============================================================================
# Upstash Redis [REQUIRED — signed-in]
# Rate limits (LLM messages, rabbit-hole nodes, homepage Ollama), tab-title cache.
# Chat POST returns 500 if Upstash is misconfigured. Free tier is enough for dev.
# Tune limits below (all optional; defaults in lib/rate-limit/).
# =============================================================================

UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# LLM_RATE_LIMIT_MESSAGES=60
# LLM_RATE_LIMIT_WINDOW=1 m
# LLM_RATE_LIMIT_TOKENS=100000
# LLM_RATE_LIMIT_TOKENS_WINDOW=1 h
# LLM_RATE_LIMIT_BY_TOKENS=false
# LLM_RATE_LIMIT_COST_UNITS=10000
# LLM_RATE_LIMIT_COST_WINDOW=1 d
# LLM_RATE_LIMIT_BY_COST=false
# RABBIT_HOLE_NODE_LIMIT=30
# RABBIT_HOLE_NODE_WINDOW=1 h
# TTS_RATE_LIMIT_REQUESTS=30
# TTS_RATE_LIMIT_CHARS=50000
# EXTERNAL_FETCH_RATE_LIMIT=20
# GOOGLE_PLACES_RATE_LIMIT=100
# EXTERNAL_FETCH_CONFIRM_SECRET=  # optional; falls back to CLERK_SECRET_KEY for model-initiated direct-fetch tokens
# PROFILE_TREE_GENERATION_LIMIT=6
# PROFILE_TREE_EDIT_LIMIT=120

# Speak Realtime (OpenAI WebRTC voice). Hard spend/minute caps for safe development.
# Also set an OpenAI org monthly budget in the OpenAI dashboard as belt-and-suspenders.
# SPEAK_REALTIME_ENABLED=true
# SPEAK_REALTIME_MODEL=gpt-realtime-mini
# SPEAK_MONTHLY_COST_CAP_USD=20
# SPEAK_DAILY_MINUTES_CAP=30

# Multi-mode plan allowlist [OPTIONAL]
# Comma-separated Clerk user ids granted the `max` plan (not subject to the free $40/mo cap).
# Do not put names or emails here — Clerk user ids only. Numeric max ceiling is unset.
# MAX_PLAN_CLERK_USER_IDS=user_...
# SPEAK_SESSION_MAX_MINUTES=8
# SPEAK_CONCURRENT_SESSIONS=1


# =============================================================================
# Memory — Qdrant + Mem0 (Aetherion) [OPTIONAL]
# Without these, memory search/ingest and /status Qdrant checks fail or no-op.
# Local Qdrant: docker run -p 6333:6333 qdrant/qdrant
# Embeddings use local Ollama (see OLLAMA_* below) via config/mem0-config.ts.
# =============================================================================

# MEMORY_API_HOST=localhost
# MEMORY_API_PORT=6333
# MEMORY_API_SECRET=
# Cloudflare Access service token, only if the Memory host sits behind an Access application.
# Both halves are required; a lone half is ignored. Use a token dedicated to this service.
# MEMORY_CF_ACCESS_CLIENT_ID=
# MEMORY_CF_ACCESS_CLIENT_SECRET=

# V2 collection (search-memories-v2-qdrant.ts, migrate script)
# MEMORY_V2_COLLECTION=memories_v2
# MEMORY_V2_EMBEDDING_DIMS=768
# MEMORY_LEGACY_COLLECTION=memories

# Arcadia memory query rewrite (lib/memory/query-rewriter.ts)
# ARCADIA_QUERY_REWRITE_ENABLED=true

# Condense activated memories over 500 chars with GPT-6 Luna after the response (default on).
# Set false to keep the sentence-boundary clip only. lib/memory/condense-activated-memories.ts
# ACTIVATED_MEMORY_CONDENSE_ENABLED=true

# Arcadia multiagent: the orchestrator writes each subagent's brief and context with its
# worktable and dispatch_subagent tools (default on). Set false to restore Jev router
# auto-dispatch of the user's words. lib/llm/subagents/orchestrator/constants.ts
# ARCADIA_ORCHESTRATOR_DISPATCH_ENABLED=true

# Memory payload encryption at rest in Qdrant [OPTIONAL]
# MEMORY_ENCRYPTION_CURRENT_KEY=k1
# MEMORY_ENCRYPTION_KEY_K1=   # base64, >= 32 decoded bytes
# MEMORY_ENCRYPTION_KEY_K2=   # optional second key for rotation


# =============================================================================
# Exa — web search tool [OPTIONAL]
# Chat web-search tool and rabbit-hole research return errors without EXA_API_KEY.
# Good News cron also uses Exa when deployed.
# =============================================================================

# EXA_API_KEY=

# Lyra research tools (optional). Docling Serve is a separately managed service.
# FIRECRAWL_API_KEY=
# DOCLING_SERVE_URL=
# DOCLING_SERVE_API_KEY=
# Optional server-reviewed provider, publisher and LLM-output reuse permissions. Default: no local reuse.
# See lib/llm/subagents/research/README.md before configuring; API keys do not grant caching rights.
# RESEARCH_REUSE_POLICY=


# =============================================================================
# Google Places — restaurant card venue data [OPTIONAL]
# gather_restaurant uses Text Search, Place Details, and Photo media.
# =============================================================================

# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACES_RATE_LIMIT=100   # per-user rolling cap per hour (default 100)


# =============================================================================
# Cohere — rabbit hole graph context reranking [OPTIONAL]
# When set, parent/child node summaries are reranked via rerank-english-v3.0.
# Without it, lexical overlap fallback is used (dev/tests).
# =============================================================================

# COHERE_API_KEY=


# =============================================================================
# ElevenLabs — text-to-speech [OPTIONAL]
# /api/ai/tts-v2 and speak UI need ELEVENLABS_API_KEY.
# =============================================================================

# ELEVENLABS_API_KEY=


# =============================================================================
# Ollama — local models [OPTIONAL]
# Homepage route preview + plan intent (/api/homepage/*); memory embeddings (nomic-embed-text).
# Requires Upstash for homepage rate limits. Defaults assume Ollama on localhost:11434.
# =============================================================================

# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_PLAN_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_API_KEY=   # only if your Ollama endpoint requires auth
# Cloudflare Access service token, only if the Ollama host sits behind an Access application.
# Both halves are required; a lone half is ignored. Use a token dedicated to this service.
# OLLAMA_CF_ACCESS_CLIENT_ID=
# OLLAMA_CF_ACCESS_CLIENT_SECRET=


# =============================================================================
# Clerk webhooks — profile sync on user.created [OPTIONAL — local]
# Run `bun run dev:full` to tunnel webhooks to /api/webhooks/clerk (needs ngrok).
# Clerk verifyWebhook reads signing secret from Clerk dashboard env (whsec_…).
# Without webhooks, sign-in works but Supabase profile row may be missing until manual fix.
# =============================================================================

# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...


# =============================================================================
# Good News cron [DEPLOY / CRON]
# Vercel cron hits /api/good-news/cron (see vercel.json). Endpoint is closed without secret.
# Preview digest locally: /good-news?preview=1 [DEMO ONLY] — no CRON_SECRET needed.
# =============================================================================

# CRON_SECRET=


# =============================================================================
# Dev / feature flags [OPTIONAL]
# =============================================================================

# NEXT_PUBLIC_SHOW_DEV_SETTINGS=true          # extra panels on /settings
# NEXT_PUBLIC_MEMORY_INGEST_DEV_UI=true       # memory-ingest sandbox dev UI
# NEXT_PUBLIC_PROMETHEUS_PROJECT=             # /sandbox/prometheus project id
# NEXT_PUBLIC_REDACT_PII=true                 # client-side PII redaction (default on)
# REDACT_PII_IN_MEMORY=true                   # redact before memory ingest (default on)
# DEBUG=1                                     # verbose logs (lib/logger.ts; try DEBUG=chat)
# LOG_TTS_FIXTURE=1                           # capture TTS stream fixtures in dev


# =============================================================================
# Memory migration script [SCRIPT ONLY]
# bun run migrate:memories-v2 — see scripts/migrate-memories-v2.ts
# Requires MEMORY_API_*, OPENAI_API_KEY, optional MEMORY_ENCRYPTION_* and OLLAMA_*.
# =============================================================================

# MIGRATE_MEMORY_USER_ID=
# MIGRATE_QUALITY_MODEL=gpt-5.4-mini
# MIGRATE_SCROLL_LIMIT=256
# MIGRATE_EMBED_BATCH=32
# MIGRATE_CLASSIFY_CONCURRENCY=20
# MIGRATE_MANUAL_FROM_COLLECTION=manual-inject
# MEMORY_MIGRATION_SYNOPSIS_MODEL=


# =============================================================================
# Playwright E2E [E2E / TEST]
# bun run test:e2e — signed-in flows need a real Clerk test user.
# =============================================================================

# E2E_CLERK_EMAIL=
# E2E_CLERK_PASSWORD=
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# AION_TEST_MODE=1   # stubs /api/ai/aion stream in e2e (default in playwright.config.ts)

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/test-results

# Supabase CLI local link state (regenerated by `supabase link`)
supabase/.temp/

# next.js
/.next/
/out/
next.config.local.cjs

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env*.local~

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

pnpm-lock.yaml
yarn.lock
package-lock.json

# Local Chats
.chats
memory.db

# Private analysis and notes
.private/
.context/
.handover/

.project-references/

# Keep local tool state private; version only shared instruction adapters.
/.cursor/*
!/.cursor/README.md
!/.cursor/skills/
!/.cursor/rules/
/.cursor/rules/*
!/.cursor/rules/subagent-card-lab.mdc
!/.cursor/rules/design-backbone.mdc
/.claude/*
!/.claude/skills/
!/.claude/rules/
/.claude/rules/*
!/.claude/rules/subagent-card-lab.md
!/.claude/rules/design-backbone.md

# Local profile (personal data, never committed)
.local-profile.md
.local-profile-overrides.ts

# Noesis demo-thread cache (generated locally, not committed)
data/noesis/

# Generated subagent identity blobs (local store; not for git)
.data/

# Local bench harness and its built output
.bench/

# clerk configuration (can include secrets)
/.clerk/
